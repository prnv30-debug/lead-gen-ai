{
  "name": "lead-gen-ai",
  "version": "1.0.0",
  "description": "Lead Generation AI MVP - Automated Scoring, Outreach Generation & Pipeline Intelligence",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "server": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "client": "npm --prefix client run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"magenta.bold,cyan.bold\" \"node --watch server/index.js\" \"npm --prefix client run dev\"",
    "build": "npm run build --workspace=client",
    "build:client": "npm run build --workspace=client",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "*",
    "lightningcss-linux-x64-gnu": "*"
  },
  "workspaces": [
    "client"
  ]
}
